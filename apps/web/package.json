{
  "name": "@weiz-nav/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "node server.js",
    "dev:turbo": "next dev --turbo",
    "generate-cert": "node scripts/generate-cert.js",
    "update-version": "node ../../scripts/sync-version.js",
    "build": "pnpm clean && pnpm update-version && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "pnpm clean && rm -rf .open-next",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm deploy:cloudflare"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.19.11",
    "@reduxjs/toolkit": "^2.3.0",
    "@weiz-nav/core": "workspace:*",
    "@weiz-nav/services": "workspace:*",
    "@weiz-nav/store": "workspace:*",
    "antd": "^6.4.3",
    "framer-motion": "^11.11.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.0",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.94.0"
  }
}
