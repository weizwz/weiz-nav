{
  "name": "weiz-nav",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "dev": "pnpm --filter @weiz-nav/web dev",
    "dev:web": "pnpm --filter @weiz-nav/web dev",
    "dev:https": "pnpm --filter @weiz-nav/web dev:https",
    "dev:extension": "pnpm --filter @weiz-nav/extension dev",
    "build": "pnpm version:sync && pnpm --filter @weiz-nav/web build",
    "build:web": "pnpm version:sync && pnpm --filter @weiz-nav/web build",
    "build:extension": "pnpm version:sync && pnpm --filter @weiz-nav/extension build",
    "lint": "pnpm --filter @weiz-nav/web lint",
    "type-check": "pnpm -r --if-present type-check",
    "deploy:cloudflare": "pnpm --filter @weiz-nav/web deploy:cloudflare",
    "preview": "pnpm --filter @weiz-nav/web preview",
    "clean": "pnpm --filter @weiz-nav/web clean"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
