{
  "name": "frontend-navigation-site",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "node server.js",
    "dev:turbo": "next dev --turbo",
    "generate-cert": "node scripts/generate-cert.js",
    "update-version": "node scripts/update-version.js",
    "build": "pnpm update-version && next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf .next out node_modules/.cache",
    "serve:static": "npx serve@latest out -p 3000",
    "deploy:vercel": "vercel --prod",
    "pages:build": "pnpm update-version && npx @cloudflare/next-on-pages",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy out --project-name=weiz-nav",
    "deploy": "pnpm deploy:cloudflare",
    "prebuild": "pnpm clean"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.0.0",
    "@ant-design/nextjs-registry": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^6.2.0",
    "framer-motion": "^11.11.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}